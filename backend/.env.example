NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/support_tickets

# Must be at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin(s), comma separated
CLIENT_URL=http://localhost:3000

# Cookie SameSite: strict | lax | none
# Defaults: "lax" in development, "none" in production (needed when frontend and API are on different domains; requires HTTPS)
# COOKIE_SAME_SITE=lax

# Used only by `npm run create-admin`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Optional: custom DNS servers (fixes Atlas SRV lookup errors on some networks)
# DNS_SERVERS=8.8.8.8,8.8.4.4
